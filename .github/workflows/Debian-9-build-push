name: inxware/Debian-9

on:
  push:
    paths:
      - '**/linux_amd64/Dockerfile'
#  workflow_call:
#   inputs:
#      username:
#        description: 'A username passed from the caller workflow'
#        default: 'john-doe'
#        required: false
#        type: string
jobs:
  Build-Push-Debian-9:

    runs-on: ubuntu-18.04

    steps:
    - uses: actions/checkout@main
    - name: Login to DockerHub Registry        
      run:  docker login -u ${{ secrets.DOCKERHUB_USERNAME }} -p ${{ secrets.DOCKERHUB_PASSWORD }} 
        
        
#    - uses: actions/checkout@main
    - name: "running into docker"
      run: | 
        docker build - < ./target/platform/linux_amd64/Dockerfile --tag zuhaibasgher/inxwaretesting
        echo "Configured inxwaretesting"
        docker push zuhaibasgher/inxwaretesting
       
