#---------------------------------------------------------------#


if [ ! -n "${1}" ] ;then
    echo "Usage" 
    echo "./configure [YOUR TARGET FROM BELOW]"
    echo "OR"
    echo "./configure help to see more utilities"

    echo "where target is one of the following target configurations:"
    ls --hide "*.mk"  ./target/platform/

   if test -e ./TARGET.cfg
   then     
     echo "____________________________________________________________"
     echo "Your build tree is currently configured for"
     cat ./TARGET.cfg
     echo "____________________________________________________________"
   fi
   exit 1
fi
if [ "$1" = "-help" -o "$1" = "help" ]; then
  echo " Utilities to help build eRT for your target: "
  echo "./configure                        : show the list of targets available"
  echo "./configure your_target            : choose a target to build for (this is sticky configuration)"
  echo "./configure -edit                  : edit ./target/platform/${TARGET} (exit to return here!) with nano" 
  echo "./configure -debug                 : run the target on this host with GDB (if the host supports it!)" 
  echo "./configure -run                   : run the target on this host (if the host supports it!)"  
  echo "./configure -test-components       : run the target on this host (if the host supports it!)"  
  echo "./configure -edit-dockerfile       : change the docker configuration (if this target has a Dockerfile)"
  echo "./configure -edit-dockerimagename  : change the name of te docke image used to build the target" 
  echo "./configure -pushd		     : cahnge directory to the ../TARGET_TREES staging directory (exit to return here)"
  echo "./confgiure -pushd-config          : change directory to ./target/platform/${TARGET} (exit to return here!)"
  echo "Use the following to see build commands and utilities:"
  echo "make help"
  exit 0
fi

# The tree is configured entirely by this reference to config files in target/platform/*
if [ "$1" = "-edit" ];then
	source ./TARGET.cfg
	nano ./target/platform/${TARGET}/config.mk
	exit
fi
if [ "$1" = "-edit-dockerfile" ]; then
	source ./TARGET.cfg
	nano ./target/platform/${TARGET}/Dockerfile
	exit
fi
if [ "$1" = "-edit-dockerimagename" ]; then
	source ./TARGET.cfg
	nano ./target/platform/${TARGET}/Dockerimagename
	exit
fi
if [ "$1" = "-debug" ]; then
	source ./TARGET.cfg
	pushd ../TARGET_TREES/ehs_env-${TARGET}/bin
	export DISPLAY=:0.0
	gdb -ex "set substitute-path inxwware ../" -ex "run" ./ehs.exe
	popd
	exit
fi
if [ "$1" = "-run" ]; then
	source ./TARGET.cfg
	pushd ../TARGET_TREES/ehs_env-${TARGET}/bin
	export DISPLAY=:0.0
	./ehs.exe
	popd
	exit
fi
if [ "$1" = "-pushd" ]; then
	source ./TARGET.cfg
	echo "Changing directory, type exit to return"
	pushd ../TARGET_TREES/ehs_env-${TARGET}/
	bash
	exit
fi
if [ "$1" = "-pushd-config" ]; then
	source ./TARGET.cfg
	echo "Changing directory, type exit to return"
	pushd ./target/platform/${TARGET}/
	bash
	exit
fi

# Check we have the config
if [ ! -d ./target/platform/$1 ]; then
    echo "ERROR TARGET [$1] Does not exist. Please use of the following or create a new profile"
    echo "mkdir -p ./target/platform/<your new platform>"
    echo "and copy a config.mk from another similar platform or base platform" 
    ls --hide "*.mk"  ./target/platform/
    exit 1
fi
# The tree is configured entirely by this reference to config files in target/platform/*
if [ "$2" = "-edit" ];then
	echo "TARGET=$1" > ./TARGET.cfg
	nano ./target/platform/${1}/config.mk
elif [ "$1" != "" ];then
	echo "TARGET=$1" > ./TARGET.cfg

fi

echo "**************************************************************************************************************************************************"
echo "The build tree is configured for target $1."
echo "Next Steps & Options:"
echo " make all_docker 		# Make the eRT runtime binary in configured docker ------->  START HERE IF YOU HAVE ALREADY CHECKED OUT THE DEPENDENCIES!"
echo " make prepdeps    	# Clone or update dependency repositories ---------------->  START HERE IF this is your first non-githib CI build"
echo " make -j 8 all 		# Build eRT directly on your host environment ------------>  Configurerd your host to build or interactive docker shell?"
echo " make targetenv		# Assemble all rutime dependencies in the staging directory: ../TARGET_TREES/ehs-env-$1"
echo " make targetpack		# Package the staging directory into a target specific package"
echo "... Ready to build ${TARGET}"
echo "type $make help for more packaging and maintenace options." 	
echo "***************************************************************************************************************************************************"
