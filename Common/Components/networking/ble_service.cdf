            <MaxValue/>
            <Description>Human-readable name for the service</Description>
            <ListPlacement>2</ListPlacement>
            <ArgPlacement>2</ArgPlacement>
        </Parameter>
        <Parameter>
            <Name>num_chars</Name>
            <DataType>I</DataType>
            <DefaultValue>4</DefaultValue>
            <MinValue>1</MinValue>
            <MaxValue>16</MaxValue>
            <Description>Number of characteristics in this service (1-16)</Description>
            <ListPlacement>3</ListPlacement>
            <ArgPlacement>3</ArgPlacement>
        </Parameter>
        <Parameter>
