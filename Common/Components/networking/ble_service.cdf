        <Height>200</Height>
        <Text>BLE Service</Text>
        <TextX>20</TextX>
        <TextY>5</TextY>
        <TextScale>1.0</TextScale>
        <TextVertical>0</TextVertical>
        <LocationX>0</LocationX>
        <LocationY>0</LocationY>
    </Block>
    <FBID>
        <ERT1_ID>1</ERT1_ID>
        <Class>ble_service</Class>
    </FBID>
