    </Hashes>
    <Parameters>
        <Parameter>
            <Name>service_uuid</Name>
            <DataType>S</DataType>
            <DefaultValue>0000180A-0000-1000-8000-00805F9B34FB</DefaultValue>
            <MinValue/>
            <MaxValue/>
            <Description>128-bit UUID for the BLE service (format: XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX) or 16-bit UUID (format: 0xXXXX)</Description>
            <ListPlacement>1</ListPlacement>
            <ArgPlacement>1</ArgPlacement>
        </Parameter>
        <Parameter>
            <Name>service_name</Name>
            <DataType>S</DataType>
            <DefaultValue>Custom Service</DefaultValue>
