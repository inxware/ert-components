    <Parameters>
        <Parameter>
            <Name>Timeout (s)</Name>
            <DataType>I</DataType>
            <DefaultValue>60</DefaultValue>
            <MinValue>1</MinValue>
            <MaxValue>3600</MaxValue>
            <Description>Watchdog timeout in seconds. System resets if kick is not called within this period.</Description>
            <ListPlacement>1</ListPlacement>
