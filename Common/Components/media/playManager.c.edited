}

#define EHS_SMILPARSER_TICK_TIME 20000
#define EHS_SMILPARSER_DEFAULT_START_GRACE 5000000 // 5 second start time

EHS_FB_INIT_FUNCTION(PlayManager) {
	EhsPlayManagerType* pPlayManager = EHS_FB_INIT_CONTEXT;
	const char* pParams;
	ehs_uint32 nPeriodIn_uS;
	ehs_uint8 nByte;
	EHS_TRACE_FUNCTION(EHS_FB_INIT_NAME(PlayManager));
	//initialise libxml library
	xmlInitParser(); //According to the docs for libxml this is required for safe multi threaded use of the libxml libraries
	LIBXML_TEST_VERSION
	/* set up the callback queue to call the callback function */
	//printf("INIT::::::: pPlayManager addr=%x",pPlayManager);
	pPlayManager->xQueue = NULL;
	pPlayManager->pFireFIData = EHS_FB_INIT_CALLBACK_FUNCTION_INSTANCE(-1); // add the instance data for the fire function
	EhsCallbackQueue_register(&(pPlayManager->xQueue),
			EHS_FB_RUN_NAME(PlayManager_Tick),
			EHS_FB_INIT_CALLBACK_FUNCTION_INSTANCE(-1), &(pPlayManager->xEntry));
	/* Initialise the timer */
	pPlayManager->xTimer.pCallback = &(pPlayManager->xQueue);
	pPlayManager->tPeriod = EhsTgtTimer_usToTick(EHS_SMILPARSER_TICK_TIME); // 100ms or do we want 10.
	pPlayManager->xTimer.tPeriod = pPlayManager->tPeriod;
	pPlayManager->NewPlaylistStartGracePeriod= (EHS_SMILPARSER_DEFAULT_START_GRACE/EHS_SMILPARSER_TICK_TIME);
	pPlayManager->bPeriodic = EHS_TRUE;
	pPlayManager->bRetriggerable = EHS_TRUE;
	//Point the event list at NULL so that we know it is empty
	pPlayManager->pEvent = NULL;
	//Same for the playlist
	//pPlayManager->pPlaylist = NULL;
	pPlayManager->ObjectUniqueID = 1;
	pPlayManager->ListUniqueID=1;
	pPlayManager->fileReader = NULL;
	pPlayManager->srcFileReader = NULL;
	pPlayManager->pMediaList = NULL;
	pPlayManager->downloadURL[0] = '\0';
	pPlayManager->downloadPath[0] = '\0';
	pPlayManager->newPlaylistBehaviour = 1;
	pPlayManager->playing = EHS_FALSE;
	//Set up the mutex for the event list
	//No longer used, everything is done in target_process.c
	/*pthread_mutex_init(&(pPlayManager->EhsL_eventList),NULL);
	 pPlayManager->EhsTPMutex_eventList = (EhsTPMutexStruct)&(pPlayManager->EhsL_eventList);*/
	return EHS_TRUE; /* initialisation always succeeds */
}

/*
 * This get the next tag in the SMIL file and returns its string.
 * This will just skip comments
 */

static ehs_char* getNextTag(xmlTextReaderPtr reader) {
	ehs_char* nextTag = NULL;
	ehs_char* name;
	int ret = 0;
	ret = xmlTextReaderRead(reader);
	while (ret == 1) {
		name = (ehs_char*) xmlTextReaderConstName(reader); // This is dealoocated with reader  -don't deallocate!
		//Ignore #text, #comment
		if ((strcmp("#text", name) == 0) || (strcmp("#comment", name) == 0)) {
			//node is a comment or node body so should be discarded for the next node
			ret = xmlTextReaderRead(reader);
		} else {
			//this not a comment or text body so is therefore the next node to be parsed so stop looping
			nextTag = name; // @todo is this bit causes a crashes when the the list is cleared (and the XML is destroyed)?
			ret = 0; //this breaks the loop
		}
	}
	return nextTag;
}


/* This updates the start and end time if these are repeat events
 * ( if the end time is ==0 this is not changed ).
 *
 */

EHS_LOCAL void UpdateEventTime(EhsPlayManagerEvent *pEvent) {
	struct tm eventTM;
	switch (pEvent->repeat) {
	case EHS_PLAYMANAGER_REPEAT_YEAR:
		//Add 1 year to event time
		gmtime_r(&(pEvent->eventTime), &eventTM);
		eventTM.tm_year = eventTM.tm_year + 1;
		pEvent->eventTime = mktime(&eventTM);
		if (pEvent->eventEndTime) {
			gmtime_r(&(pEvent->eventEndTime), &eventTM);
			eventTM.tm_year = eventTM.tm_year + 1;
			pEvent->eventEndTime = mktime(&eventTM);

		}
		break;
	case EHS_PLAYMANAGER_REPEAT_MONTH:
		//Add 1 month to event time
		gmtime_r(&(pEvent->eventTime), &eventTM);
		//Deal with year rolling over
		if (eventTM.tm_mon == 12) {
			eventTM.tm_mon = 1;
			eventTM.tm_year = eventTM.tm_year + 1;
		} else {
			eventTM.tm_mon = eventTM.tm_mon + 1;
		}
		pEvent->eventTime = mktime(&eventTM);
		if (pEvent->eventEndTime) {
			gmtime_r(&(pEvent->eventEndTime), &eventTM);
			if (eventTM.tm_mon == 12) {
				eventTM.tm_mon = 1;
				eventTM.tm_year = eventTM.tm_year + 1;
			} else {
				eventTM.tm_mon = eventTM.tm_mon + 1;
			}
			eventTM.tm_year = eventTM.tm_year + 1;
			pEvent->eventEndTime = mktime(&eventTM);
		}

		break;
	case EHS_PLAYMANAGER_REPEAT_DAY:
		//Add 24 hours to event time
		pEvent->eventTime = pEvent->eventTime
				+ EHS_FB_MEDIA_PLAYMANAGER_DAY_SECONDS; //number of seconds in 24 hours
		if (pEvent->eventEndTime) {
			pEvent->eventEndTime = pEvent->eventEndTime
							+ EHS_FB_MEDIA_PLAYMANAGER_DAY_SECONDS; //number of seconds in 24 hours
			}
		break;
	default:
		;
		//removeEvent(pEvent); cant call this because we need the previous and playmanage structure.
	}

}

static void parseWallClockValue(ehs_char* value, EhsPlayManagerEvent *pEvent, ehs_bool bEndTime) {
	int length = 0;
	time_t t = -1;
	struct tm tm;
	struct tm currenttm;
	time_t currentt;
	ehs_char *pEndBrace, *pWallClockValue;
	//test length of value, if it is longer than "wallclock(" then test to see if it starts with wallclock
	if (strlen(value) >= 10) {
		if (strncmp(value, "wallclock(", 10) == 0) {
			//starts with wallclock, now chomp whitespace from that brace
			pWallClockValue = &value[10];
			while (*pWallClockValue == ' ') {
				pWallClockValue++;
			}
			//get positon of closing brace
			pEndBrace = strchr(value, ')');
			if (pEndBrace != NULL) {
				//then chomp whitespace backwards
				do {
					pEndBrace--;
				} while (*pEndBrace == ' ');
				//make sure the end is greater than the start otherwise something has gone wrong (like an empty wallclock value)
				if (pWallClockValue < pEndBrace) {
					//Set the character one after the end our wallclock value as null so that our string terminates
					*(pEndBrace + 1) = '\0'; //left hand side says "increment pEndBrace to point at the next char then set the value held within", we must remember to set this to non null otherwise we risk leaking memory in the xml clean up function
					//get current time and date so we can fill in any missing values
					currentt = time(NULL);
					gmtime_r(&currentt, &currenttm);
					//Find out what format the time is in
					//we are going to strlen, since each datetime format is of a different length we can use that to reliably determine the format
					length = strlen(pWallClockValue);
					switch (length) {
					//hh:mm:ss
					case 8:
						if ((void *) strptime((char*) pWallClockValue,
								"%H:%M:%S", &tm) != NULL) {
							tm.tm_mday = currenttm.tm_mday;
							tm.tm_mon = currenttm.tm_mon;
							tm.tm_year = currenttm.tm_year;
							if (!bEndTime) pEvent->repeat = EHS_PLAYMANAGER_REPEAT_DAY; //repeat daily
						}
						break;
						//DDThh:mm:ss
					case 11:
						if ((void *) strptime(pWallClockValue, "%dT%H:%M:%S",
								&tm) != NULL) {
							tm.tm_mon = currenttm.tm_mon;
							tm.tm_year = currenttm.tm_year;
							if (!bEndTime) pEvent->repeat = EHS_PLAYMANAGER_REPEAT_MONTH; //repeat monthly, 1 is reserved for week repeat
						}
						break;
						//MM-DDThh:mm:ss
					case 14:
						if ((void *) strptime(pWallClockValue,
								"%m-%dT%H:%M:%S", &tm) != NULL) {
							tm.tm_year = currenttm.tm_year;
							if (!bEndTime) pEvent->repeat = EHS_PLAYMANAGER_REPEAT_YEAR; //repeat yearly, probably not needed
						}
						break;
						//YYYY-MM-DDThh:mm:ss
					case 19:
						strptime(pWallClockValue, "%Y-%m-%dT%H:%M:%S", &tm);
						if (!bEndTime) pEvent->repeat = EHS_PLAYMANAGER_REPEAT_NONE; //no repeat
						break;
					default:
						if (length > 19) { // try umatching a fully qualified time - perhaps has time zone implemented.
							strptime(pWallClockValue, "%Y-%m-%dT%H:%M:%S", &tm);
							if (!bEndTime) pEvent->repeat = EHS_PLAYMANAGER_REPEAT_NONE; //no repeat
							break;
						} else {
							//printf("Wallclock Value not recognised\n");
						}
					}
					//printf("parseWallClockValue:current: year: %d; month: %d; day: %d; hour: %d; minute: %d; second: %d, week day: %d, year day: %d\n", currenttm.tm_year, currenttm.tm_mon, currenttm.tm_mday, currenttm.tm_hour, currenttm.tm_min, currenttm.tm_sec, currenttm.tm_wday, currenttm.tm_yday);
					//printf("parseWallClockValue:calculated: year: %d; month: %d; day: %d; hour: %d; minute: %d; second: %d, week day: %d, year day: %d\n", tm.tm_year, tm.tm_mon, tm.tm_mday, tm.tm_hour, tm.tm_min, tm.tm_sec, tm.tm_wday, tm.tm_yday);
					//parsed time so lets see what we have
					t = mktime(&tm);
					if (!bEndTime) {
						pEvent->eventTime = t;
					}
					else {
						pEvent->eventEndTime = t;
					}
					*(pEndBrace + 1) = ' '; //Clear away null character we put in earlier so that we don't leak memory
				} else {
					//badly positioned braces for wallclock value
				}
			} else {
				//could not find end of wallclock value
			}
		} else {
			//does not start with wallclock(
		}
	} else {
		//not long enough to be a wallclock value
	}
}

/*
 * called when the closing body tag is expected
 */

static void closingBodyTag(xmlTextReaderPtr reader) {
	ehs_char* nextTag;
	nextTag = getNextTag(reader);
	if (nextTag != NULL) {
		if ((strcmp(nextTag, "smil") == 0) && (xmlTextReaderNodeType(reader)
				== 15)) {
			//closing smilTag found so just stop!
		} else {
			printf("closingBodyTag: expected closing smil. Found %s\n", nextTag);
		}
	} else {
		printf("closingBodyTag: failed to get nextTag\n");
	}
}

/*
 * Call this to post an event into the list for playing.
 * The event supplied will be pre-populated with a time or a waiting flag if it belongs to a sequence.
 */

static void addToEventList(EhsPlayManagerEvent* pNewEvent,
		EhsPlayManagerType* pPlayManager) {
	EhsPlayManagerEvent *pCurrentEvent = NULL;
	//if list is empty just put it on as the first item
	//printf("WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW New Event =%x, next=%x\n",pNewEvent,pNewEvent->pNext);
	pNewEvent->pNext = NULL;//Just in case it was not inited properly.
	if (pPlayManager->pEvent == NULL) {
		pPlayManager->pEvent = pNewEvent;
		//printf("\nAdding Event to List - first - time = %d\n",pNewEvent->eventTime);
	} else {
		//List is not empty so run over it and find the new place for it
		pCurrentEvent = pPlayManager->pEvent;
		//Positioning logic is that it should go at the end of the list, we can thus assume that the list will be time ordered due to assuming we are only dealing with time ordered playlists at this phase
		//printf("QQQQQQaddToEventList:pCurrentEvent =%x\n", pCurrentEvent);
		while (pCurrentEvent->pNext != NULL) {
			//printf("QQQQaddToEventList:pCurrentEvent=%x pCurrentEvent->pNext =%x, pCurrentEvent-.PARSTUFF =%x, resource=%s\n", pCurrentEvent,pCurrentEvent->pNext,pCurrentEvent->parEventList,pCurrentEvent->pMediaSource);
			pCurrentEvent = pCurrentEvent->pNext;
		}
		//We have reached the end of the event list. pCurrentEvent should point to the last entry in the list
		pCurrentEvent->pNext = pNewEvent;
		//printf("\nAdding Event to List\n");
	}
	//printf("addToEventList\n");
	//PrintEvent(pNewEvent);
}

/*
 * Clears all events for the playmanager
 */

EHS_LOCAL void clearEventList(EhsPlayManagerType* pPlayManager) {
	EhsPlayManagerEvent *pCurrentEvent = pPlayManager->pEvent;
	EhsPlayManagerEvent *pNextEvent = NULL;
	printf("CLEARING EVENTLIST\n");
	//while not NULL free the event and move on
	EHSH_LOG_INFO("Clearing Event List");
	while (pCurrentEvent != NULL) {
		pNextEvent = pCurrentEvent->pNext;
		FreeAllEventMemory(pCurrentEvent);
		pCurrentEvent = pNextEvent;

	}
	ClearMediaList(pPlayManager);
	pPlayManager->pEvent = NULL; //flag it is empty
	printf("Last Event is %x\n", pCurrentEvent);
	//also clear the memory reader so that the played port won't start upsetting things if we have no events
}

InitEvent(EhsPlayManagerEvent * Event) {

	Event->eventTime = 0;
	Event->eventEndTime = 0;
	Event->repeat = EHS_PLAYMANAGER_REPEAT_NONE;
	Event->pNext = NULL;
	Event->type = EHS_PLAYMANAGER_EVENT_UNKOWN;
	Event->eventListType = EHS_PLAYMANAGER_EVENTLIST_UNKOWN;
	Event->playlistSize = 0;
	Event->memoryReader = NULL;
	Event->pPlaylist = NULL;
	Event->pMediaSource = NULL;
	Event->class = NULL;
	Event->srcType = NULL;
	Event->region = NULL;
	Event->WaitingForObjectUniqueID = 0; //  Default is 0 so we play non-list stuff .. (idiot!)
	Event->SendersObjectUniqueID = -1; // Default sender is different to 0 in case it slips through.
	Event->ListUniqueID = 0; //set to zero to indicate this is not a list related event
	Event->bCurrentPlayStarted =EHS_FALSE;
	Event->parEventList=NULL;
	//Event->parListAllPlayed=EHS_FALSE;
	//before the next element in the list is parsed. default to 0 which means ready to play.
}

/*
 *
 * CreateTimeEvent - populates the event structure. from SMIL attributes.
 * It will also populate an end event structure if there is an end time present.
 * The end time structure is always of the type EHS_PLAYMANAGER_EVENT_END - and should be populated
 * with the ID and resource name.
 *
 * Call this to populate an event (supplied) with the time data is parsed from the next SMIL node. *
 *
 * This is used for all SMIL nodes that might have time data begin & end.
 * If there is no time data the default parent time value is assigned as the begin time.
 */

//@todo this should check the inout end time against the read-in one and use the the earliset for the end time.
ehs_bool CreateTimeEvent(xmlTextReaderPtr reader,
		EhsPlayManagerEvent **pStartEvent, EhsPlayManagerEvent **pEndEvent,
		time_t * parent_start_time, time_t * parent_end_time, ehs_bool MediaObject) {
	ehs_char * value = NULL;
	ehs_bool ret = EHS_FALSE;
	//We will always have a start event - even if the begin is not present. We will use the parent time in this case.
	//printf("b4 Allocated pStartEvent=%x\n", *pStartEvent);
	*pStartEvent
			= (EhsPlayManagerEvent*) EhsHMem_tempAlloc(sizeof(EhsPlayManagerEvent)); //assume we have an end event for now
	//printf("Allocated pStartEvent=%x\n", *pStartEvent);

	if ((*pStartEvent) != NULL) {
		InitEvent(*pStartEvent);

		ret = EHS_TRUE;
		(*pStartEvent)->pNext = NULL; // just an initialiser for the linked list.
		//(*pStartEvent)->type = EHS_PLAYMANAGER_EVENT_BEGIN;// this could be an immediate event or a list type
		(*pStartEvent)->repeat = EHS_PLAYMANAGER_REPEAT_NONE; //assume no repeat to start with
		value = xmlTextReaderGetAttribute(reader, "begin"); // get the start time wall clock value
		//Test for NULL value, if it is null then just use current time
		if (value == NULL) {
			(*pStartEvent)->eventTime = *parent_start_time;//This will cause it to fire on the parent time instead
		} else {
			parseWallClockValue(value, (*pStartEvent), EHS_FALSE); // populate the event data with the time value. This creates an absolute time and records if it was a a regular event.
			xmlFree(value); // remove the XML for the attribute only ??
		}
		//	if ((*pStartEvent)->eventTime > 0) { //otherwise we try and sort out the cross misnight problem for non-fully specified wall-clock times
		//@todo we should repeat all the above for weeks & months? - unlikely we have a sequence that crosses these types of boundaries for more than one day?			value = xmlTextReaderGetAttribute(reader, "end");
		//if there is no end time then free the end event because we don't need one
		value = xmlTextReaderGetAttribute(reader, "end");

		//put this in a new element of the start event.
		if ((value == NULL) && (*parent_end_time == 0)) { // there is not end time implied for this
			(*pEndEvent) = NULL;
			//printf("XXXX->No time Found for parent or child , adding event for this event\n");
		} else {
#ifdef EHS_PLAYMANAGER_CREATE_END_EVENTS
			(*pEndEvent)
			= (EhsPlayManagerEvent*) EhsHMem_tempAlloc(sizeof(EhsPlayManagerEvent)); //assume we have an end event for now
			if ((*pEndEvent) != NULL) {
				InitEvent(*pEndEvent);
				(*pEndEvent)->type = EHS_PLAYMANAGER_EVENT_END;
				(*pEndEvent)->repeat = EHS_PLAYMANAGER_REPEAT_NONE; //assume no repeat to start with
				if (value == NULL) {
					(*pEndEvent)->eventTime = *parent_end_time;
					//printf(
							"XXXX->Not Found end time, adding event for this event\n");

				} else {
					printf(
							"XXXX->Found end time, adding event for this event = %d\n",
							value);

					parseWallClockValue(value, (*pEndEvent)); // populate the event data with the time value. This creates an absolute time and records if it was a a regular event.

					xmlFree(value); // remove the XML for the attribute only ??
				}
#else
			// Yes this is when we have found an end time  in the SMIL, we add it to the start event ....
			if (value != NULL) {
				parseWallClockValue(value, (*pStartEvent), EHS_TRUE); // now add the end event info to the start event..
			}
#endif

		}

#ifdef EHS_PLAYMANAGER_CREATE_END_EVENTS
		if (((*pEndEvent) != NULL) && ((*pEndEvent)->eventTime != 0)) // Do some logic here to allow cross midnight, week end or months ends for regular events
		{
			//if (*pEndEvent)->eventTime is less than (*pStartEvent)->event but within a day of it then add one day to (*pEndEvent), this is to represent playlists that run over midnight
			if (((*pEndEvent)->eventTime < (*pStartEvent)->eventTime)
					&& ((*pEndEvent)->eventTime > (*pStartEvent)->eventTime
							- EHS_FB_MEDIA_PLAYMANAGER_DAY_SECONDS)) {
				(*pEndEvent)->eventTime = (*pEndEvent)->eventTime
				+ EHS_FB_MEDIA_PLAYMANAGER_DAY_SECONDS; //this should be safe to assume one day as any other repeat period would specify the days so the confusion would not occur in the first place
			}
			(*pStartEvent)->eventEndTime=(*pEndEvent)->eventTime;// we need to copy this for list types so the end time can be identified by children
		}
		if ((*pEndEvent) && ((*pEndEvent)->eventTime == 0)) { //only create an end event if this is a Media Object.otherwise just update the parent time.
			EhsHMem_tempFree(*pEndEvent);
			*pEndEvent = NULL;
		}
#endif

	} else { // we couldn't alloc a start event
		ret = EHS_FALSE;
		EHSH_LOG_ERROR("Could not allocate start event memory");
	}
	return ret;
} /*end Function

 return ret;// returns if we got at least a being time. If not the begin time is still populated with now
 //we may be returning nulls here
 }

