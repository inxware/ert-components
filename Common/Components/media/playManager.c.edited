	printf(
			"//EVENT//\neventTime=%ld\ntype=%i\npPlaylist=%s\npMediaSource=%s, ID=%d, TYPE=%s, ListType=%d Addr=%x\n",
			pEvent->eventTime, pEvent->type, pEvent->pPlaylist,
			pEvent->pMediaSource,pEvent->WaitingForObjectUniqueID,pEvent->srcType,pEvent->eventListType,pEvent);
}

