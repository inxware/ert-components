<?xml version="1.0" encoding="UTF-8"?>
<Component>
  <Class>EventNegativeEdgeDetect</Class>
  <Block>
    <Type>Event_Processor</Type>
  </Block>
  <Menu>Event
    <Menu>Boolean Control
      <Menu>-ve Edge Detect</Menu>
    </Menu>
  </Menu>
  <LongDescription>This object is asserted an event when a negative edge is detected on a boolean.</LongDescription>
  <Port>
