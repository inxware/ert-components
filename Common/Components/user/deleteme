/* Server thread - Waits for connections and writes data to a buffer and calls the receive callback function and sends any data */
EHS_FB_THREAD_FUNCTION(netSocket_waitforconnection) {
	ehs_bool init =EHS_TRUE;
/* Now start polling for data */
while(init)
	{
		/* tcpip initialisation */
		ehs_bool ClientConnected = EHS_TRUE;
		ehs_uint32 TestUsageCount = 0u;

		//EhsSvcTcp_log("***Client connected\n");

		while (ClientConnected && !inx_netSocket_state->closenow)
		{
			TestUsageCount++;
			ClientConnected = EhsSvcTcp_receive();

			if (ClientConnected)
			{
				ClientConnected = EhsSvcTcp_send();
			}

		}

		init = EhsSvcTgtTcp_closeConnection(inx_netSocket_state->connection_socket);
		if (init != EHS_FALSE) {EHSH_LOG_ERROR("COuld not close socket trying again");} //todo this should dtop trying at some point.
		inx_netSocket_state->closenow=-1; /* So the a close falg setter knows it is closed or another opener*/
	}
}


