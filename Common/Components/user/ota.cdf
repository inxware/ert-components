    <Description>
        <ShortDescription>Over-the-air update</ShortDescription>
        <LongDescription>This will write to the inactive OTA section with the incoming data. The data could be written in the non-contiguous manner with offset.</LongDescription>
        <UserName/>
        <Menu>
            System
            <Menu>OTA</Menu>
        </Menu>
    </Description>
    <FBID>
        <ERT1_ID>1</ERT1_ID>
        <Class>OTA</Class>
    </FBID>
    <Hashes>
        <NameHash_CRC16>0x27CF</NameHash_CRC16>
        <FbApiDescriptorHash_CRC32>1f295a23</FbApiDescriptorHash_CRC32>
        <FbApiDescriptorHash/>
    </Hashes>
    <Parameters>
