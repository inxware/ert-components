EHS_TARGET_HAL_OTA_PATH=$(EHS_TARGET_COMPONENT_HAL_PATH)/system/ota
VPATH +=: $(EHS_TARGET_HAL_OTA_PATH)
INC_DIRS += $(EHS_TARGET_HAL_OTA_PATH)


ifeq ($(EHS_OTA_SUPPORT),stubbed)
  DEFS+=EHS_OTA_SUPPORT=EHS_OTA_SUPPORT_STUBBED
  OBJECTS += ota_hal_stubb.$(OBJ)
else
  DEFS+=EHS_OTA_SUPPORT=EHS_OTA_SUPPORT_SUPPORT
  OBJECTS += target_ota.${OBJ}
endif