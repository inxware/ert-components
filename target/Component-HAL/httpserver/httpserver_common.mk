ifneq ($(EHS_HTTPSERVER_SUPPORT),none)

	EHS_TARGET_HTTPSERVER_PATH=$(EHS_TARGET_COMPONENT_HAL_PATH)/httpserver/$(EHS_HTTPSERVER_SUPPORT)
	DEFS += EHS_HTTPSERVER_SUPPORT=0

	# include sourcecode path of this dir in build
	VPATH+=$(EHS_TARGET_HTTPSERVER_PATH)
	INC_DIRS+=$(EHS_TARGET_HTTPSERVER_PATH)

	include $(EHS_TARGET_HTTPSERVER_PATH)/httpserver.mk

endif