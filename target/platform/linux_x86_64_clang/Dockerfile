# inxware/inx-debian10-clang10
From debian:10
RUN echo "Successfully entered and fetched debian:10"
RUN apt-get update
RUN echo "installing build essential and git"
RUN apt-get install -y \
	git git-lfs \
	build-essential \
	automake cmake \
	libtool	\
	libtinfo5 \
	clang llvm \
	libcurl4-openssl-dev \
	libarchive-dev \
	libexpat1-dev \
	libexpat-dev \
	libidn2-0-dev  \
	zlib1g-dev \
	libxml2-dev \
	libgtk2.0-dev \
	libgstreamer1.0-dev \
	libgstreamer-plugins-base1.0-dev
