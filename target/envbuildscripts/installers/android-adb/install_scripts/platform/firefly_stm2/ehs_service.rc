# This file is the LOCAL_INIT_RC file for the ehs service scripts.

on property:sys.boot_completed=1
    # start ehs service script
    start ehs_service
    
service ehs_service /system/bin/sh /system/bin/ehs_service.sh
    user root
    disabled
    group root shell log
    seclabel u:r:su:s0
    oneshot
